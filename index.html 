<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dukaan Bill Maker</title>
<style>
:root{--bg:#f2efe8;--card:#fff;--ink:#1d1b18;--mute:#6b665d;--line:#d8d2c4;--acc:#b3261e;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#17150f;--card:#221f18;--ink:#f1ece0;--mute:#a39d8e;--line:#3a3629;--acc:#ff7a6e;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#17150f;--card:#221f18;--ink:#f1ece0;--mute:#a39d8e;--line:#3a3629;--acc:#ff7a6e;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif;padding:12px}
.wrap{max-width:560px;margin:0 auto}
h1{font-size:20px;margin:4px 0 12px}
h2{font-size:15px;margin:0 0 8px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:12px}
label{display:block;font-size:12px;color:var(--mute);margin:8px 0 2px}
input,textarea{width:100%;padding:9px;border:1px solid var(--line);border-radius:7px;background:transparent;color:var(--ink);font:inherit}
.row{display:flex;gap:8px}.row>*{flex:1;min-width:0}
.item{border-top:1px dashed var(--line);padding-top:8px;margin-top:8px}
.item .row input{padding:8px 6px}
button{font:inherit;padding:10px 14px;border-radius:8px;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
button.p{background:var(--acc);border-color:var(--acc);color:#fff;font-weight:600}
button.x{color:var(--acc);padding:6px 10px;font-size:13px}
.bar{display:flex;gap:8px;flex-wrap:wrap}
#rcpt{position:relative;background:#fff;color:#111;font:13px/1.4 Calibri,Carlito,"Segoe UI",Arial,sans-serif;padding:14px 12px;border:1px solid var(--line);max-width:380px;margin:0 auto}
#rcpt .c{text-align:center}#rcpt .b{font-weight:700}
#rcpt hr{border:0;border-top:1px solid #444;margin:6px 0}
#rcpt table{width:100%;border-collapse:collapse}
#rcpt td,#rcpt th{padding:1px 0;vertical-align:top;text-align:left}
#rcpt .r{text-align:right}
#rcpt .sm{font-size:12px}
#rcpt .big{font-size:19px;font-weight:600}
#rcpt .st1{position:absolute;right:12px;bottom:90px;writing-mode:vertical-rl;transform:rotate(180deg);border:2px solid #d9372b;color:#d9372b;font:700 17px Arial,sans-serif;letter-spacing:1px;padding:6px 3px;opacity:.85;-webkit-print-color-adjust:exact;print-color-adjust:exact}
#rcpt .st2{position:absolute;left:62px;bottom:4px;writing-mode:vertical-rl;border:2px solid #5b3fa0;color:#5b3fa0;font:700 17px Arial,sans-serif;letter-spacing:2px;padding:6px 4px;transform:rotate(166deg);opacity:.8;-webkit-print-color-adjust:exact;print-color-adjust:exact}
#rcpt .pad{height:46px}
#rcpt .st3{position:absolute;right:50px;bottom:100px;border:2px solid #d9372b;color:#d9372b;border-radius:4px;font:800 24px Arial,sans-serif;padding:2px 8px;transform:rotate(-16deg);opacity:.85;-webkit-print-color-adjust:exact;print-color-adjust:exact}
@media print{
body{background:#fff;padding:0}.wrap>*:not(#out){display:none!important}
#out{display:block!important;margin:0;padding:0;border:0}#out h2,#out .bar{display:none}
#rcpt{border:0;max-width:none;width:80mm;margin:0}
@page{margin:2mm}}
</style>
</head>
<body>
<div class="wrap">
<h1>Bill Maker</h1>

<div class="card">
<h2>Dukaan ki details</h2>
<label>Dukaan ka naam</label><input id="shop" value="Garha Bhandars">
<label>Address</label><textarea id="addr" rows="2">B-1/1, Deeplex Building, Vikas Nagar Extension, Lucknow (Uttar Pradesh)</textarea>
<div class="row"><div><label>Phone</label><input id="ph"></div><div><label>GSTIN</label><input id="gstin"></div></div>
<div class="row"><div><label>User / Cashier</label><input id="user"></div><div><label>Shop code</label><input id="scode"></div></div>
<label>Terms (har line alag)</label>
<textarea id="terms" rows="5">No Guarantee For Color, Work & Zari.
Exchange Within 7 Days With Tags and Bill.
No Refund after Billing.
No Cash Refund.
All Subject to LUCKNOW Jurisdiction.</textarea>
</div>

<div class="card">
<h2>Bill</h2>
<div class="row"><div><label>Memo No.</label><input id="memo" inputmode="numeric"></div><div><label>Date &amp; time</label><input id="dt" type="datetime-local"></div></div>
<label>Customer / Firm ka naam (jiske naam pe GST bill)</label><input id="cname" placeholder="Jaise Sharma Traders">
<div class="row"><div><label>Customer GST No. (15 digit)</label><input id="cgst" maxlength="15" style="text-transform:uppercase"></div><div><label>Contact No.</label><input id="cph" inputmode="tel"></div></div>
<div class="row"><div><label>Payment mode</label><input id="pay" value="CC"></div></div>
<label>GST type</label><select id="ttype" style="width:100%;padding:9px;border:1px solid var(--line);border-radius:7px;background:var(--card);color:var(--ink);font:inherit"><option value="l">Local (CGST + SGST)</option><option value="i">Dusre state (IGST)</option></select>
<label style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="s1" checked style="width:auto"> NO EXCHANGE stamp lagao</label>
<label style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="s2" checked style="width:auto"> DELIVERED stamp lagao</label>
<label style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="s3" checked style="width:auto"> PAID stamp lagao</label>
<div id="items"></div>
<div class="bar" style="margin-top:10px"><button id="add">+ Item jodo</button></div>
</div>

<div class="card" id="out">
<h2>Preview</h2>
<div id="rcpt"></div>
<div class="bar" style="margin-top:10px;justify-content:center">
<button class="p" id="print">Print / PDF save</button>
<button id="next">Naya bill</button>
</div>
</div>
</div>

<script>
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?'':s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const f2=n=>(Math.round(n*100)/100).toFixed(2);
const f5=n=>(Math.round(n*1e5)/1e5).toFixed(5);
let items=[{d:'',h:'',q:1,m:'',g:5}];
const saved=['shop','addr','ph','gstin','user','scode','terms','pay'];

function words(n){
 const a=['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
 const t=['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
 const two=x=>x<20?a[x]:t[Math.floor(x/10)]+(x%10?' '+a[x%10]:'');
 if(n===0)return 'Zero';
 let o='';const cr=Math.floor(n/1e7),lk=Math.floor(n/1e5)%100,th=Math.floor(n/1e3)%100,hu=Math.floor(n/100)%10,r=n%100;
 if(cr)o+=two(cr)+' Crore ';if(lk)o+=two(lk)+' Lakh ';if(th)o+=two(th)+' Thousand ';if(hu)o+=a[hu]+' Hundred ';
 if(r)o+=two(r);return o.trim();
}

function drawItems(){
 $('items').innerHTML=items.map((it,i)=>`<div class="item">
 <input data-i="${i}" data-k="d" placeholder="Item ka naam (jaise Crop Top)" value="${esc(it.d)}">
 <div class="row" style="margin-top:6px">
 <input data-i="${i}" data-k="h" placeholder="HSN" inputmode="numeric" value="${esc(it.h)}">
 <input data-i="${i}" data-k="q" placeholder="Qty" inputmode="decimal" value="${esc(it.q)}">
 <input data-i="${i}" data-k="m" placeholder="MRP ₹" inputmode="decimal" value="${esc(it.m)}">
 <input data-i="${i}" data-k="g" placeholder="GST %" inputmode="decimal" value="${esc(it.g)}">
 <button class="x" data-del="${i}">Hatao</button></div></div>`).join('');
}

function render(){
 let tot=0,tax=0,qty=0;const g={};const igst=$('ttype').value==='i';
 const rows=items.filter(it=>it.d||it.m).map((it,i)=>{
  const q=parseFloat(it.q)||0,m=parseFloat(it.m)||0,gr=parseFloat(it.g)||0;
  const amt=q*m,taxable=amt/(1+gr/100),t=amt-taxable;
  tot+=amt;tax+=t;qty+=q;
  g[gr]=g[gr]||{v:0,t:0};g[gr].v+=taxable;g[gr].t+=t;
  return `<tr style="${i?'border-top:1px solid #888':''}"><td>${i+1}</td><td>${esc(it.d)}</td><td class="r">${f2(q)}</td><td class="r">${esc(it.m)}</td><td class="r">${Math.round(amt*100)/100}</td></tr>
  <tr><td></td><td colspan="4" class="sm">${it.h?'HSN : '+esc(it.h)+' &nbsp;':''}Taxable Amt :${f5(taxable)}</td></tr><tr><td></td><td colspan="4" class="sm" style="padding-bottom:5px">${igst?`IGST @${gr.toFixed(3)}% : ${f5(t)}`:`CGST @${(gr/2).toFixed(3)}% : ${f5(t/2)} | SGST @${(gr/2).toFixed(3)}% : ${f5(t/2)}`}</td></tr>`;
 }).join('');
 const net=Math.round(tot);
 const gl=Object.keys(g).map(k=>(igst?`GST ${k}% of Value ${f2(g[k].v)}: (IGST: ${f2(g[k].t)})`:`GST ${k}% of Value ${f2(g[k].v)}: (CGST: ${f2(g[k].t/2)} SGST: ${f2(g[k].t/2)})`)).join('<br>');
 const dt=$('dt').value?new Date($('dt').value):new Date();
 const p=n=>String(n).padStart(2,'0');
 const ds=`${p(dt.getDate())}-${p(dt.getMonth()+1)}-${dt.getFullYear()} ${p(dt.getHours())}:${p(dt.getMinutes())}`;
 const terms=$('terms').value.split('\n').filter(x=>x.trim()).map((x,i)=>`${i+1}.) ${esc(x)}`).join('<br>');
 $('rcpt').innerHTML=`<div class="c b" style="font-size:15px">${esc($('shop').value)}</div>
 <div class="c sm">${esc($('addr').value).replace(/\n/g,'<br>')}<br>${$('ph').value?'Phone : '+esc($('ph').value)+'<br>':''}${$('gstin').value?'GSTIN No: '+esc($('gstin').value):''}</div>
 <div class="c b" style="margin:6px 0">***INVOICE***</div>
 <table><tr><td>Memo No. : <b>${esc($('memo').value)}</b></td><td class="r">Date : ${ds}</td></tr>
 <tr><td>User : ${esc($('user').value)}</td><td class="r">${$('scode').value?'L.Code: '+esc($('scode').value):''}</td></tr></table><hr>
 ${$('cname').value?'<div class="c b">Name: '+esc($('cname').value)+'</div>':''}<div class="c b">GST No: ${esc($('cgst').value.toUpperCase())}</div><div class="c b">Contact No.: ${esc($('cph').value)}</div><hr>
 <table style="table-layout:fixed"><colgroup><col style="width:8%"><col><col style="width:13%"><col style="width:16%"><col style="width:18%"></colgroup><tr><th>Sr</th><th>Description</th><th class="r">Qty.</th><th class="r">MRP</th><th class="r">NetAmt</th></tr><tr><td colspan="5"><hr style="margin:2px 0"></td></tr>${rows||'<tr><td colspan="5">Item add karo</td></tr>'}</table><hr>
 <table><tr><td colspan="2">Grand Total :</td><td class="r">${Math.round(tot*100)/100}</td></tr>
 <tr><td>ItemCount: ${rows?items.filter(it=>it.d||it.m).length:0}</td><td style="text-align:center;font-size:15px">Tax (Incl.)</td><td class="r">${f2(tax)}</td></tr></table><hr>
 <table><tr><td class="big">Net Payable Amount</td><td class="r big">${net}</td></tr></table><hr>
 <div>Rupees ${words(net)} Only.</div>
 <div style="margin-top:4px">${esc($('pay').value)}: ${f2(net)}</div>
 <div class="sm" style="margin-top:4px">${gl}</div><div class="b" style="margin-top:4px">Total GST Payable : ${f2(tax)}${igst?' (IGST)':' (CGST '+f2(tax/2)+' + SGST '+f2(tax/2)+')'}</div>
 <div style="margin-top:8px"><u>Terms &amp; Condition</u></div><div class="sm">${terms}</div>
 <div style="margin-top:8px">E.&amp;O.E</div>
 <div class="c" style="margin-top:8px">****Thank You, Please Visit Again****</div><div class="pad"></div>${$('s1').checked?'<div class="st1">NO EXCHANGE</div>':''}${$('s2').checked?'<div class="st2">DELIVERED</div>':''}${$('s3').checked?'<div class="st3">PAID</div>':''}`;
 try{saved.forEach(k=>localStorage.setItem('bm_'+k,$(k).value));localStorage.setItem('bm_last',$('memo').value)}catch(e){}
}

function load(){
 try{saved.forEach(k=>{const v=localStorage.getItem('bm_'+k);if(v!==null)$(k).value=v});
 const l=parseInt(localStorage.getItem('bm_last'));if(l)$('memo').value=l+1}catch(e){}
 if(!$('memo').value)$('memo').value=1;
 const d=new Date(),p=n=>String(n).padStart(2,'0');
 $('dt').value=`${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
}

document.addEventListener('input',e=>{
 const t=e.target;
 if(t.dataset.k){items[t.dataset.i][t.dataset.k]=t.value}
 render();
});
document.addEventListener('click',e=>{
 const t=e.target;
 if(t.dataset.del!==undefined){items.splice(t.dataset.del,1);if(!items.length)items=[{d:'',h:'',q:1,m:'',g:5}];drawItems();render()}
});
$('add').onclick=()=>{items.push({d:'',h:'',q:1,m:'',g:5});drawItems();render()};
$('print').onclick=()=>window.print();
$('next').onclick=()=>{items=[{d:'',h:'',q:1,m:'',g:5}];$('memo').value=(parseInt($('memo').value)||0)+1;$('cgst').value='';$('cph').value='';$('cname').value='';load2();drawItems();render()};
function load2(){const d=new Date(),p=n=>String(n).padStart(2,'0');$('dt').value=`${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`}
load();drawItems();render();
</script>
</body>
</html>
